---
/**
 * Home: the life cover calculator on the first screen, then the reference page (RECETTE §5, §21): what the
 * state pays when a parent dies, the chance a term policy pays out by age (ONS), three households worked
 * through, why no price is shown, the shapes of cover, and the sick pay gap. Every figure comes from the
 * engine or the parameter file.
 * Naive testers and audit of 2026-11-09: the first screen is the question, the answer in one sentence, a
 * "where to start" line and the calculator; the long reference sections below the households fold under their
 * own title (kept whole in the HTML); links are real links (set:html), never escaped text; each household
 * card says every amount its total counts, from the same inputs the engine adds up.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './Tool.astro';
import Sources from './Sources.astro';
import Clamp from './Clamp.astro';
import { COVER_DEFAULTS, SICK_DEFAULTS, article } from '../lib/cover-defaults';
import { route } from '../i18n/routes';
import { PAGES } from '../lib/guides';
import { groupLabel, GROUPS_ORDER } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { LAST_UPDATED, AUTHOR_NAME } from '../data/site-config';
import { displayDate } from '../lib/format';
import { faqSchema, webApplicationSchema, websiteSchema, organizationSchema } from '../lib/seo';
const lang = 'en';
const h = helpers(true);
const { P, E, m, m2, pc } = h;
const B = P.bsp;

// The calculator's own default case, so the text matches what the reader sees first.
const C = COVER_DEFAULTS;
const DEF = { mortgage: C.mortgage, debts: C.debts, funeral: C.funeral, income: C.income, years: C.years, extra: C.extra, savings: C.savings, deathInService: C.dis, existing: C.existing, partner: C.partner, children: C.kids, countBsp: true };
const def = E.coverNeed(DEF);
const higher = E.bsp('married', true), standard = E.bsp('married', false);

// Three households. The description is written from the same inputs the engine adds up, so every amount in
// the total is named (audit of 2026-11-09: 425,000 computed by the reader against 428,000 shown).
type In = Parameters<typeof E.coverNeed>[0];
const describe = (i: In, extraText: string) => [
  i.mortgage > 0 ? `${m(i.mortgage)} left on the mortgage` : 'no mortgage',
  i.debts > 0 ? `${m(i.debts)} of other debts` : '',
  `${m(i.income)} a year of income needed for ${i.years} years`,
  i.extra > 0 ? `${m(i.extra)} ${extraText}` : '',
  `${m(i.funeral)} for a funeral`,
  i.savings > 0 ? `${m(i.savings)} of savings` : '',
  i.deathInService > 0 ? `${m(i.deathInService)} of life cover from work` : '',
  i.existing > 0 ? `an old ${m(i.existing)} policy` : '',
].filter(Boolean).join(', ').replace(/^./, (c) => c.toUpperCase()) + '.';
const F1: In = { mortgage: 0, debts: 3000, funeral: 5000, income: 30000, years: 14, extra: 0, savings: 6000, deathInService: 96000, existing: 0, partner: 'cohabiting', children: true, countBsp: true };
const F2: In = { mortgage: 240000, debts: 12000, funeral: 6000, income: 18000, years: 8, extra: 30000, savings: 20000, deathInService: 0, existing: 0, partner: 'married', children: true, countBsp: true };
const F3: In = { mortgage: 60000, debts: 0, funeral: 6000, income: 10000, years: 10, extra: 0, savings: 40000, deathInService: 0, existing: 100000, partner: 'married', children: false, countBsp: true };
// Testers of 2026-11-10: the reader of 61 found her case third, mid-page; the oldest household now comes first.
const fams = [
  { who: 'Married, children grown up (earner aged 58)', what: describe(F3, ''), r: E.coverNeed(F3), age: 58, sex: 'm' as const, term: F3.years },
  { who: 'Married homeowners, two teenagers (earner aged 47)', what: describe(F2, 'for university'), r: E.coverNeed(F2), age: 47, sex: 'f' as const, term: F2.years },
  { who: 'Renting couple, not married, one child of 4 (earner aged 31)', what: describe(F1, ''), r: E.coverNeed(F1), age: 31, sex: 'm' as const, term: F1.years },
];

// Sick pay strip: the site's one sick pay example (brief of 2026-11-10, rule 1: one figure per case).
const SDf = SICK_DEFAULTS;
const sick = E.sickGap({ monthlyPay: SDf.pay, monthlyNeed: SDf.need, fullWeeks: SDf.full, halfWeeks: SDf.half, age: C.age, employee: true });
const about = (x: number) => m(Math.round(x / 100) * 100);
// Where to start: the cases the testers came with. Second round of 2026-11-09: a reader of 24 with no child
// and no loan, and one of 61 close to retirement, had no door; each now loads its own example into the
// calculator (`ex=1`: still marked as an example), and over 50s plans are named for what they are.
const preset = (q: Record<string, string | number>) => `${route('home', lang)}?ex=1&${Object.entries(q).map(([k, v]) => `${k}=${v}`).join('&')}#calculator`;
// Brief of 2026-11-10 (rule 2): doors by profile are buttons above the calculator. Those that load an example
// say so; those that open another page are set apart and end with an arrow.
const loads = [
  { href: preset({ a: C.age, s: C.sex, p: C.partner, c: 1, mo: C.mortgage, de: C.debts, fu: C.funeral, i: C.income, y: C.years, x: C.extra, sa: C.savings }), label: 'Parent or couple with a mortgage' },
  { href: preset({ a: 25, s: 'f', p: 'none', c: 0, mo: 0, de: 3000, fu: 5000, i: 0, y: 10, x: 0, sa: 2000 }), label: 'Under 30, renting, no children' },
  { href: preset({ a: 61, s: 'f', p: 'married', c: 0, mo: 40000, de: 0, fu: 5000, i: 12000, y: 6, x: 0, sa: 30000 }), label: 'Over 55, children grown up' },
];
const opens = [
  { href: route('life-insurance-unmarried-couples', lang), label: 'Living together, not married' },
  { href: route('income-protection-insurance', lang), label: 'Worried about being off sick' },
  { href: route('over-50s-life-insurance', lang), label: 'A small policy for funeral costs' },
];

const nSrc = Object.keys(P.sources).length;
const faqs = [
  { q: 'How much life insurance do I need in the UK?', a: `Add what your family would have to pay or replace: the mortgage, other debts, a funeral, the income they would lose for the years it matters, and any lump sums for the children. Take off savings they could use, death in service from work, policies you already hold and, for a married couple with children, ${m(higher.total)} of Bereavement Support Payment. The calculator above does the sum with your own figures.` },
  { q: 'Does the government pay anything if my husband or wife dies?', a: `Yes, if the person who died paid enough National Insurance and the survivor is under State Pension age. Bereavement Support Payment is ${m(B.higherLump)} plus ${B.months} monthly payments of ${m(B.higherMonthly)} for a parent getting Child Benefit, or ${m(B.standardLump)} plus ${B.months} payments of ${m(B.standardMonthly)} without children. It is not means-tested, and the claim must be made within ${B.fullClaimMonths} months for the full amount.` },
  { q: 'What are the chances my term life insurance actually pays out?', a: `At today’s death rates, a man of 40 who takes a 25-year policy has a ${pc(E.payoutChance(40, 25, 'm'))} chance of dying within the term, and a woman of the same age ${pc(E.payoutChance(40, 25, 'f'))}, on the official UK death statistics (the ONS, Office for National Statistics, life tables for 2022 to 2024). Insured people tend to be healthier than the population as a whole, so the real figure for policyholders is likely lower.` },
  { q: 'Why does this site not show life insurance prices?', a: 'Because no price source exists that a website may republish: insurer and broker quotes are their own data, the industry claims figures are not licensed for reuse here, and the averages some sites print come with no method. A price that cannot be traced is not shown. What can be shown without a form is the size of the gap and the odds of a claim, from public data.' },
  { q: 'Is life insurance worth it if my employer gives four times salary?', a: 'Death in service pays only while you work for that employer and stops the day you leave, retire or are made redundant. Enter it in the calculator as cover you already have: if it covers the gap, a personal policy adds nothing today, but it is worth checking again at each change of job.' },
  { q: 'Do I have to give my phone number to use the calculator?', a: 'No. There is no form, no account and no callback. Everything runs in your browser and nothing you type is sent anywhere: the address bar only changes if you copy a link to share your own figures. The site has nothing to sell you and passes no details to insurers or brokers.' },
];
const jsonLd = [webApplicationSchema({ name: 'Life cover calculator', description: 'Life cover needed after Bereavement Support Payment, death in service and savings, with the chance a policy pays out.', path: route('home', lang), lang }), websiteSchema(lang), organizationSchema(lang), faqSchema(faqs, lang)];
const groups = GROUPS_ORDER.map((g) => ({ g, pages: PAGES.filter((p) => p.group === g) })).filter((x) => x.pages.length);
// Citable block (§21), rewritten for the brief of 2026-11-10 (rule 3): the method in words, one figure, no
// chain of amounts the reader has just seen in the calculator.
const exampleText = `A life insurance calculator should start from what your family would actually have to pay, not from a multiple of your salary. This one adds the mortgage still owed, other debts, a funeral, the income the family would lose for the years it matters, and any lump sums for the children. It then takes off what would already arrive: Bereavement Support Payment, the state payment to a husband, wife or civil partner (up to ${m(higher.total)} for a parent), life cover from your job, policies you already hold and savings the family could use. What is left is the cover to buy, and its length is the number of years someone depends on your income. Each line of the result shows one of these amounts, so the sum can be checked by hand. Nothing you type leaves your browser, and no insurer or broker sees it.`;
---
<PageLayout title="Life Insurance Calculator UK 2026/27: Cover After State Help" description="Life insurance calculator for 2026/27: the cover your family needs after Bereavement Support Payment and death in service, and the chance a policy pays out." lang={lang} jsonLd={jsonLd} faqs={faqs} faqOuverte={0}>
  <header class="mb-3">
    <h1 class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">How much life insurance you need, once the state has paid its share</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">This life insurance calculator adds up what your family would need, then takes off what the state, your job and your savings would already pay: what is left is the cover to buy. No quote form, no prices, no phone call.</p>
    <p class="mt-1 text-xs text-navy-600">Independent site, not an insurer, broker or government service: benefit claims are made only on GOV.UK.</p>
  </header>
  <nav data-chrome data-depart aria-label="Closest to you?" class="mb-3 text-sm">
    <p class="font-semibold text-navy-900">Closest to you? Tap to load that example into the calculator below:</p>
    <ul class="mt-1 flex flex-wrap gap-1.5">
      {loads.map((s) => <li><a href={s.href} class="inline-flex min-h-11 items-center rounded-full border border-accent-600 bg-white px-3 py-1 font-medium text-accent-800 no-underline hover:bg-accent-50">{s.label}</a></li>)}
    </ul>
  </nav>
  <div id="calculator" data-outil class="mb-4 scroll-mt-20"><Tool tool={{ kind: 'need' }} primary={true} /></div>
  <nav data-chrome aria-label="Other cases" class="mb-4 text-sm">
    <p class="font-semibold text-navy-900">Not your case? Go straight to:</p>
    <ul class="mt-1 flex flex-wrap gap-1.5">
      {opens.map((s) => <li><a href={s.href} class="inline-flex min-h-11 items-center rounded-full border border-navy-300 bg-navy-50 px-3 py-1 font-medium text-navy-900 no-underline hover:bg-white">{s.label} →</a></li>)}
    </ul>
  </nav>
 <p class="mb-6 text-sm text-navy-600">Worked out by {AUTHOR_NAME} · <a href={route('method', lang)} class="underline hover:text-navy-900">How the figures are worked out</a> · <a href={route('about', lang)} class="underline hover:text-navy-900">Who publishes this site</a></p>

  <Clamp text={exampleText} id="clamp-home" class="mb-8" />

  <section class="not-prose my-10" aria-labelledby="state-title">
    <h2 id="state-title" class="text-2xl font-bold text-navy-900">What the state pays when a parent dies, {P.taxYear}</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="border-t-4 border-accent-600 bg-accent-50 p-4"><p class="text-sm font-semibold text-navy-700">Married or civil partners, child at home</p><p class="tabular-nums mt-1 text-3xl font-bold text-navy-900">{m(higher.total)}</p><p class="mt-2 text-sm text-navy-800">{m(B.higherLump)} at once, then {B.months} × {m(B.higherMonthly)}. Higher rate.</p></div>
      <div class="border-t-4 border-navy-400 bg-navy-50 p-4"><p class="text-sm font-semibold text-navy-700">Married or civil partners, no child</p><p class="tabular-nums mt-1 text-3xl font-bold text-navy-900">{m(standard.total)}</p><p class="mt-2 text-sm text-navy-800">{m(B.standardLump)} at once, then {B.months} × {m(B.standardMonthly)}. Standard rate.</p></div>
      <div class="border-t-4 border-navy-400 bg-navy-50 p-4"><p class="text-sm font-semibold text-navy-700">Living together, not married</p><p class="tabular-nums mt-1 text-3xl font-bold text-navy-900">{m(higher.total)} or nothing</p><p class="mt-2 text-sm text-navy-800">Higher rate if the survivor gets Child Benefit for a child living with them or is pregnant; otherwise nothing.</p></div>
    </div>
    <div class="mt-4 space-y-2 text-navy-800">
      <p>This is Bereavement Support Payment, at the rates set by the DWP (Department for Work and Pensions) for {P.taxYear}. It is a short bridge, not an income: spread over {B.months} months, the higher rate comes to about {m(higher.total / B.months)} a month.</p>
      <p>No state benefit clears a mortgage, and since April 2017 none pays a widowed parent until the children grow up: that is the gap life cover exists to fill.</p>
      <p>Who qualifies: the person who died paid enough National Insurance in any one tax year, and the survivor is under State Pension age. Claim within {B.fullClaimMonths} months of the death to get it all; after {B.lastClaimMonths} months nothing is paid.</p>
    </div>
  </section>

  <section class="not-prose my-10" aria-labelledby="sick-title">
    <!-- Testers of 2026-11-10: “Death is the smaller risk” shocked the reader of 61, and one paragraph chained five amounts. One sentence, one figure. -->
    <h2 id="sick-title" class="text-2xl font-bold text-navy-900">Being off sick is the likelier risk: the sick pay gap</h2>
    <div class="mt-3 space-y-2 text-navy-800">
      <p>At working age, a long spell off work is more likely than death, and the state pays less for it.</p>
      <p>Statutory Sick Pay (SSP), the legal minimum an employer must pay, is at most {m2(P.ssp.weekly)} a week, for up to {P.ssp.maxWeeks} weeks.</p>
      <p>After that, New Style ESA (Employment and Support Allowance), the state benefit for people too ill to work, pays {m2(P.esa.assessment25)} a week from age 25, if your National Insurance record qualifies.</p>
      <p>Take an employee on {m(SDf.pay)} a month who spends {m(SDf.need)} a month. Over two years off sick, about <strong>{about(sick.income)}</strong> comes in.</p>
      <p>Counting only the weeks when that falls below {m(SDf.need)} a month, the household ends up about <strong>{about(sick.shortfall)}</strong> short.</p>
      <p><Fragment set:html={h.a('income-protection-insurance', 'Income protection: how much')} /> works this out week by week, with your own pay and your employer’s scheme.</p>
    </div>
  </section>

  <section class="not-prose my-10" aria-labelledby="fams-title">
    <h2 id="fams-title" class="text-2xl font-bold text-navy-900">Three households, worked through with the life insurance calculator</h2>
    <div class="mt-5 grid gap-5 lg:grid-cols-3">
      {fams.map((f) => (
        <div class="border border-navy-200 p-4">
          <p class="font-semibold text-navy-900">{f.who}</p>
          <p class="mt-1 text-sm text-navy-700">{f.what}</p>
          <dl class="mt-3 grid grid-cols-[1fr_auto] gap-x-3 gap-y-1 text-sm">
            <dt class="text-navy-700">Family would need</dt><dd class="tabular-nums text-right text-navy-900">{m(f.r.gross)}</dd>
            <dt class="text-navy-700">State bereavement payment</dt><dd class="tabular-nums text-right text-navy-900">{f.r.state > 0 ? `− ${m(f.r.state)}` : 'none'}</dd>
            <dt class="text-navy-700">Savings and cover already in place</dt><dd class="tabular-nums text-right text-navy-900">− {m(f.r.inPlace - f.r.state)}</dd>
            <dt class="font-semibold text-navy-900">Cover still needed</dt><dd class="tabular-nums text-right font-semibold text-navy-900">{m(f.r.need)}</dd>
            <dt class="text-navy-700">Chance {article(f.term)} {f.term}-year policy pays</dt><dd class="tabular-nums text-right text-navy-900">{pc(E.payoutChance(f.age, f.term, f.sex))}</dd>
          </dl>
        </div>
      ))}
    </div>
    <ul class="mt-4 list-disc space-y-1 pl-5 text-navy-800">
      <li>Children grown up: the old policy and the savings cover almost everything, so little new cover is needed.</li>
      <li>Teenagers at home: a large sum for a short time, which is where a short term is cheap.</li>
      <li>Not married, one child: the child makes the survivor eligible for the higher rate (without a child, nothing), and the cover from work counts only while the earner stays in that job.</li>
    </ul>
  </section>

  <div class="prose prose-slate max-w-none">
    <details class="repli-section">
      <summary class="cursor-pointer py-3 font-semibold text-accent-700 underline underline-offset-2">Show the {nSrc} official sources behind every figure</summary>
      <Sources lang={lang} intro="Every State benefit rate, tax rule and ONS life table figure behind this calculator and its guides was taken from these GOV.UK, HMRC, FCA and ONS pages, read on" />
      <p>Every rate comes from the {nSrc} official pages listed above: the DWP’s <Fragment set:html={h.src('gov_rates', 'benefit and pension rates for 2026 to 2027')} />, GOV.UK’s guides to <Fragment set:html={h.src('gov_bsp', 'Bereavement Support Payment')} />, <Fragment set:html={h.src('gov_ssp', 'Statutory Sick Pay')} /> and <Fragment set:html={h.src('gov_esa', 'New Style ESA')} />, and the ONS <Fragment set:html={h.src('ons_nlt', 'national life tables')} />. Every sum is checked again against worked examples each time the site is rebuilt.</p>
    </details>
  </div>

  <section class="mt-10" aria-labelledby="guides-title">
    <details>
      <summary class="cursor-pointer"><h2 id="guides-title" class="inline text-2xl font-bold text-navy-900">Every calculator on the site</h2> <span class="text-sm text-navy-600">· {PAGES.length} calculators, by subject</span></summary>
      <div class="mt-4 space-y-6">
        {groups.map(({ g, pages }) => (
          <div class="grid gap-2 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-6">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-navy-600">{groupLabel(g)}</h3>
            <ul class="space-y-2">{pages.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav}</a> <span class="text-sm text-navy-600">{p.card}</span></li>)}</ul>
          </div>
        ))}
      </div>
    </details>
  </section>
</PageLayout>
