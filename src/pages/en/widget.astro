---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/life-cover-calculator/" title="Life cover calculator, UK 2026/27" width="100%" height="1150" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the UK life cover calculator 2026/27 on your own site" description="Show the life cover calculator on your own site for free: one iframe, Bereavement Support Payment and death in service counted, ONS payout odds, no sign-up and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the life cover calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For an advice centre’s money guide, an HR intranet, a union’s benefits page or a personal finance article: visitors enter a mortgage, an income and their family, and see the cover still needed once the state and their employer have paid their share.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible and use it as it is, without warranty. When the rates change, the embedded calculator updates itself.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/life-cover-calculator/" title="Life cover calculator, UK 2026/27" width="100%" height="1150" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
